{
  "name": "gen-vscode",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "publisher": "magomedcoder",
  "icon": "media/logo.png",
  "license": "MIT",
  "version": "0.6.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/magomedcoder/gen-vscode"
  },
  "l10n": "./l10n",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Programming Languages",
    "AI",
    "Chat",
    "Gen",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gen.commentSelection",
        "title": "%command.commentSelection.title%",
        "category": "%extension.category%"
      },
      {
        "command": "gen.commentFile",
        "title": "%command.commentFile.title%",
        "category": "%extension.category%"
      },
      {
        "command": "gen.openChat",
        "title": "%command.openChat.title%",
        "category": "%extension.category%"
      },
      {
        "command": "gen.openChatPanel",
        "title": "%command.openChatPanel.title%",
        "category": "%extension.category%"
      },
      {
        "command": "gen.openChatEditor",
        "title": "%command.openChatEditor.title%",
        "category": "%extension.category%"
      },
      {
        "command": "gen.initProject",
        "title": "%command.initProject.title%",
        "category": "%extension.category%"
      },
      {
        "command": "gen.addSelectionToChat",
        "title": "%command.addSelectionToChat.title%",
        "category": "%extension.category%"
      },
      {
        "command": "gen.addToChat",
        "title": "%command.addToChat.title%",
        "category": "%extension.category%"
      },
      {
        "command": "gen.explainSelection",
        "title": "%command.explainSelection.title%",
        "category": "%extension.category%"
      },
      {
        "command": "gen.improveSelection",
        "title": "%command.improveSelection.title%",
        "category": "%extension.category%"
      },
      {
        "command": "gen.addTerminalToChat",
        "title": "%command.addTerminalToChat.title%",
        "category": "%extension.category%"
      },
      {
        "command": "gen.notebook.addCell",
        "title": "%command.notebook.addCell.title%",
        "category": "%extension.category%"
      },
      {
        "command": "gen.notebook.explainCell",
        "title": "%command.notebook.explainCell.title%",
        "category": "%extension.category%"
      },
      {
        "command": "gen.notebook.improveCell",
        "title": "%command.notebook.improveCell.title%",
        "category": "%extension.category%"
      },
      {
        "command": "gen.notebook.generateCell",
        "title": "%command.notebook.generateCell.title%",
        "category": "%extension.category%"
      },
      {
        "command": "gen.manageWorktrees",
        "title": "%command.manageWorktrees.title%",
        "category": "%extension.category%"
      },
      {
        "command": "gen.dryRunHook",
        "title": "%command.dryRunHook.title%",
        "category": "%extension.category%"
      },
      {
        "command": "gen.design.pickFromClipboard",
        "title": "%command.designPickFromClipboard.title%",
        "category": "%extension.category%"
      },
      {
        "command": "gen.hunk.accept",
        "title": "%command.hunkAccept.title%",
        "category": "%extension.category%"
      },
      {
        "command": "gen.hunk.reject",
        "title": "%command.hunkReject.title%",
        "category": "%extension.category%"
      },
      {
        "command": "gen.generateCommitMessage",
        "title": "%command.generateCommitMessage.title%",
        "category": "%extension.category%",
        "icon": "$(sparkle)"
      },
      {
        "command": "gen.abortCommitMessage",
        "title": "%command.abortCommitMessage.title%",
        "category": "%extension.category%"
      }
    ],
    "keybindings": [
      {
        "command": "gen.openChat",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g"
      },
      {
        "command": "gen.addSelectionToChat",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "gen.commentSelection",
        "key": "ctrl+alt+/",
        "mac": "cmd+alt+/",
        "when": "editorHasSelection && editorTextFocus"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "gen",
          "title": "%viewsContainers.panel.gen.title%",
          "icon": "media/logo.svg"
        }
      ]
    },
    "views": {
      "gen": [
        {
          "type": "webview",
          "id": "gen.chatView",
          "name": "%views.gen.chatView.name%",
          "icon": "media/logo.svg"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "gen.hunk.accept",
          "when": "false"
        },
        {
          "command": "gen.hunk.reject",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "gen.addToChat",
          "when": "editorHasSelection && editorTextFocus",
          "group": "gen@0"
        },
        {
          "command": "gen.explainSelection",
          "when": "editorHasSelection && editorTextFocus",
          "group": "gen@1"
        },
        {
          "command": "gen.improveSelection",
          "when": "editorHasSelection && editorTextFocus",
          "group": "gen@2"
        },
        {
          "command": "gen.commentSelection",
          "when": "editorHasSelection && editorTextFocus",
          "group": "gen@3"
        },
        {
          "command": "gen.commentFile",
          "when": "editorTextFocus",
          "group": "gen@4"
        }
      ],
      "terminal/context": [
        {
          "command": "gen.addTerminalToChat",
          "group": "gen@1"
        }
      ],
      "notebook/cell/title": [
        {
          "command": "gen.notebook.addCell",
          "group": "gen@1"
        },
        {
          "command": "gen.notebook.explainCell",
          "group": "gen@2"
        },
        {
          "command": "gen.notebook.improveCell",
          "group": "gen@3"
        },
        {
          "command": "gen.notebook.generateCell",
          "group": "gen@4"
        }
      ],
      "scm/title": [
        {
          "command": "gen.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "**/.gen/config.json",
          "**/gen/config.json"
        ],
        "url": "./schemas/gen-config.schema.json"
      },
      {
        "fileMatch": [
          "**/.gen/hooks.json",
          "**/gen/hooks.json"
        ],
        "url": "./schemas/gen-hooks.schema.json"
      },
      {
        "fileMatch": [
          "**/.gen/shell.json",
          "**/gen/shell.json"
        ],
        "url": "./schemas/gen-shell.schema.json"
      },
      {
        "fileMatch": [
          "**/.gen/references.json",
          "**/.gen/references/*.json"
        ],
        "url": "./schemas/gen-references.schema.json"
      },
      {
        "fileMatch": [
          "/etc/gen/policy.json",
          "**/.config/gen/policy.json",
          "**/gen/policy.json"
        ],
        "url": "./schemas/gen-policy.schema.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "compile": "yarn run check-types && yarn run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "yarn run check-types && yarn run lint && node esbuild.js --production",
    "package:vsix": "vsce package --yarn --no-dependencies",
    "compile-tests": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && tsc -p tsconfig.test.json",
    "watch-tests": "tsc -p tsconfig.test.json -w",
    "pretest": "yarn run compile-tests && yarn run compile && yarn run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:eval": "vscode-test --grep eval"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "tree-sitter-wasms": "^0.1.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "optionalDependencies": {
    "playwright": "^1.49.0"
  },
  "dependencies": {
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "ignore": "^7.0.5",
    "jimp": "^1.6.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
