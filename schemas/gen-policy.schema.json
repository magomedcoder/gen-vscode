{
	"$schema": "https://json-schema.org/draft-07/schema#",
	"$id": "https://raw.githubusercontent.com/magomedcoder/gen-vscode/main/schemas/gen-policy.schema.json",
	"title": "Gen Agent admin policy",
	"description": "Managed / admin policy (MDM-style MVP). Loaded from GEN_ADMIN_POLICY, /etc/gen/policy.json (Unix), or %ProgramData%/gen/policy.json (Windows). Keys present here lock and force effective GenSettings; project/UI cannot override them.",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string",
			"description": "JSON Schema URL or path (metadata)."
		},
		"version": {
			"type": "integer",
			"description": "Policy document version (metadata)."
		},
		"description": {
			"type": "string",
			"description": "Human-readable note (metadata)."
		},
		"approvalPolicy": {
			"type": "object",
			"description": "Forced approval policy (shell / edits / delete / web / outside / task / skill)."
		},
		"autoApprove": { "type": "boolean" },
		"continueLoopOnDeny": { "type": "boolean" },
		"enableTerminal": { "type": "boolean" },
		"enableFileReading": { "type": "boolean" },
		"enableWorkspaceContext": { "type": "boolean" },
		"webSearchEnabled": { "type": "boolean" },
		"webFetchEnabled": { "type": "boolean" },
		"allowExternalDirectory": { "type": "boolean" },
		"otelEnabled": { "type": "boolean" },
		"otelEndpoint": { "type": "string" },
		"indexingEnabled": { "type": "boolean" },
		"embeddingsBaseUrl": { "type": "string" },
		"baseUrl": { "type": "string" },
		"planModel": { "type": "string" },
		"actModel": { "type": "string" },
		"smallModel": { "type": "string" },
		"localEmbeddingsMode": {
			"type": "string",
			"enum": ["off", "trigram", "vector"]
		}
	},
	"additionalProperties": false
}
